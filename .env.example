# docker compose 가 읽는 값 (compose.yaml 의 ${...} 치환용)
# 복사해서 사용:  copy .env.example .env
#
# 주의: 이 값들은 컨테이너를 "처음 만들 때"만 반영된다.
#       이미 볼륨(rag-study-pgdata)이 있으면 USER/PASSWORD/DB 를 바꿔도 적용되지 않는다.
#       바꾸려면 docker compose down -v 로 볼륨을 지우고 다시 올려야 한다(데이터 삭제됨).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=변경하세요
POSTGRES_DB=ragdb

# 호스트에 노출할 포트. 로컬에 다른 PostgreSQL 이 5432 를 쓰고 있으면 15432 등으로 변경
POSTGRES_PORT=5432
